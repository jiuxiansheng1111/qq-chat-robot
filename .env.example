APP_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=./data/qqchat.db
REDIS_URL=redis://redis:6379/0
EVENT_DEDUPE_TTL_SECONDS=300
# High-ceiling anti-spam guard for all incoming group messages.
INGRESS_USER_RATE_LIMIT_PER_MINUTE=60
INGRESS_GROUP_RATE_LIMIT_PER_MINUTE=300
# Generic AI chat is limited separately; local commands and deterministic memory answers do not consume this quota.
# New names prevent old USER_RATE_LIMIT_PER_MINUTE=5 values from keeping the legacy strict behavior.
LLM_USER_RATE_LIMIT_PER_MINUTE=20
LLM_GROUP_RATE_LIMIT_PER_MINUTE=120
# When a rate limit is hit, send at most one warning per user within this cooldown.
RATE_LIMIT_NOTICE_COOLDOWN_SECONDS=10
PLUGIN_MODULES=app.plugins.hello

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=qqchat-robot
JWT_AUDIENCE=qqchat-admin
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=14
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# 本机 NapCat 示例：http://127.0.0.1:3000；Docker 运行机器人时通常使用 http://host.docker.internal:3000
ONEBOT_API_BASE=
# 对应 OneBot HTTP Server 的 token
ONEBOT_ACCESS_TOKEN=
# 对应 OneBot HTTP Client（事件上报）的 token
ONEBOT_WEBHOOK_TOKEN=
ONEBOT_SELF_ID=3503565007

# 可选：第二个 NapCat / QQ 机器人账号。不需要双账号时全部留空。
# 如果两个 NapCat 同时运行，请给第二个实例使用不同 HTTP 端口，例如 3001。
# ONEBOT_API_BASE_2 留空时会复用 ONEBOT_API_BASE，适合两个账号轮流运行的场景。
ONEBOT_API_BASE_2=
ONEBOT_ACCESS_TOKEN_2=
# 留空时复用 ONEBOT_WEBHOOK_TOKEN；需要两个 HTTP Client 使用不同 Token 时再填写。
ONEBOT_WEBHOOK_TOKEN_2=
ONEBOT_SELF_ID_2=

LLM_PROVIDER=zhipu
LLM_MODEL=glm-4.7-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=change-me
LLM_FALLBACK_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=3000
LLM_TEMPERATURE=0.7
LLM_MAX_CONCURRENCY=10
LLM_QUEUE_SIZE=30
LLM_QUEUE_TIMEOUT_SECONDS=8
# When enabled, difficult/current @ questions may be sent to Bing RSS automatically.
AUTO_WEB_SEARCH_ENABLED=false
AUTO_WEB_SEARCH_LIMIT=5
# Optional HTTP proxy for Bing/Baidu/Wikipedia/image traffic.
# Clash Verge Rev commonly uses 7897; older Clash configs often use 7890.
# Leave empty to auto-detect 127.0.0.1:7897/7890/7891 and Docker host equivalents.
WEB_PROXY_URL=
WEB_PROXY_AUTO_DETECT=true

PERSONA_NAME=小丛雨
PERSONA_PROMPT_FILE=prompts/persona.txt
PERSONA_EXAMPLES_FILE=prompts/examples.jsonl
MAX_CONTEXT_MESSAGES=100
# 连续相同纯文本出现两次时自动复读一次；命令、链接和 @机器人 问句不会触发。
REPEAT_ECHO_ENABLED=true
# 最多从 NapCat 拉取 3000 条群历史并缓存在进程内；注入模型仍受字符预算保护。
GROUP_CONTEXT_HISTORY_COUNT=3000
GROUP_CONTEXT_MESSAGE_LIMIT=3000
GROUP_CONTEXT_CHAR_LIMIT=120000
QQ_SEND_CHUNK_CHARS=1800

# CATAAS: random cat GIF; no API key required
CAT_API_URL=https://cataas.com/cat/gif
CAT_TIMEOUT_SECONDS=12
CAT_CACHE_SIZE=2
# Wikimedia Commons: curated real pig photographs; no API key required
PIG_API_URL=https://commons.wikimedia.org/w/api.php
MEDIA_MAX_BYTES=5242880
MEDIA_TIMEOUT_SECONDS=60
MEDIA_RETRY_ATTEMPTS=2

# Deezer public search: broad international catalog and 30-second previews; no key required.
MUSIC_API_URL=https://api.deezer.com
MUSIC_TIMEOUT_SECONDS=10
MUSIC_SEARCH_LIMIT=8
# Primary music catalog. This is NetEase Cloud Music's web search endpoint,
# not an official public developer API, so it may change without notice.
NETEASE_MUSIC_API_URL=https://music.163.com/api/search/get

# Bilibili public web search. The bot bootstraps anonymous cookies automatically.
BILIBILI_SEARCH_URL=https://api.bilibili.com/x/web-interface/search/type
BILIBILI_TIMEOUT_SECONDS=10
BILIBILI_SEARCH_RESULT_LIMIT=20

# Possession style learning: recent OneBot history is analyzed in the background.
# Raw chat messages are never saved; only a compact style summary is persisted.
POSSESSION_STYLE_HISTORY_COUNT=200
# 每名成员的进程内样本与风格匹配最多保留 200 条。
POSSESSION_STYLE_SAMPLE_LIMIT=200
POSSESSION_STYLE_REFRESH_HOURS=24
# Active possession recall scans the member's latest 200 messages for precise matching.
POSSESSION_RECALL_HISTORY_COUNT=200
POSSESSION_RECALL_RESULT_LIMIT=12
