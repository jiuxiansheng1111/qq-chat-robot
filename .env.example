APP_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=./data/qqchat.db
REDIS_URL=redis://redis:6379/0
EVENT_DEDUPE_TTL_SECONDS=300
# 为所有群消息设置较高的入口限流阈值。
INGRESS_USER_RATE_LIMIT_PER_MINUTE=60
INGRESS_GROUP_RATE_LIMIT_PER_MINUTE=300
# 普通 AI 对话单独限流；本地命令和确定性记忆回答不占用此额度。
# 使用新变量名，避免旧 USER_RATE_LIMIT_PER_MINUTE=5 继续触发严格限流。
LLM_USER_RATE_LIMIT_PER_MINUTE=20
LLM_GROUP_RATE_LIMIT_PER_MINUTE=120
# 触发限流后，在冷却时间内每位用户最多收到一次提示。
RATE_LIMIT_NOTICE_COOLDOWN_SECONDS=10
PLUGIN_MODULES=app.plugins.hello

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=qqchat-robot
JWT_AUDIENCE=qqchat-admin
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=14
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# 本机 NapCat 示例：http://127.0.0.1:3000；Docker 运行机器人时通常使用 http://host.docker.internal:3000
ONEBOT_API_BASE=
# 对应 OneBot HTTP Server 的 token
ONEBOT_ACCESS_TOKEN=
# 对应 OneBot HTTP Client（事件上报）的 token
ONEBOT_WEBHOOK_TOKEN=
ONEBOT_SELF_ID=

# 可选：第二个 NapCat / QQ 机器人账号。不需要双账号时全部留空。
# 如果两个 NapCat 同时运行，请给第二个实例使用不同 HTTP 端口，例如 3001。
# ONEBOT_API_BASE_2 留空时会复用 ONEBOT_API_BASE，适合两个账号轮流运行的场景。
ONEBOT_API_BASE_2=
ONEBOT_ACCESS_TOKEN_2=
# 留空时复用 ONEBOT_WEBHOOK_TOKEN；需要两个 HTTP Client 使用不同 Token 时再填写。
ONEBOT_WEBHOOK_TOKEN_2=
ONEBOT_SELF_ID_2=

LLM_PROVIDER=zhipu
LLM_MODEL=glm-4.7-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=change-me
LLM_FALLBACK_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=3000
LLM_TEMPERATURE=0.7
LLM_MAX_CONCURRENCY=10
LLM_QUEUE_SIZE=30
LLM_QUEUE_TIMEOUT_SECONDS=8
# 开启后，复杂或时效性强的 @ 提问可自动查询 Bing RSS。
AUTO_WEB_SEARCH_ENABLED=false
AUTO_WEB_SEARCH_LIMIT=5
# Bing、百度、维基百科和图片请求可选代理。
# Clash Verge Rev 常用 7897；旧版 Clash 配置常用 7890。
# 留空时自动探测 127.0.0.1:7897/7890/7891 及对应的 Docker 主机地址。
# 代理关闭或无法建立连接时自动直连，无需重启；外部服务仍须允许直连访问。
WEB_PROXY_URL=
WEB_PROXY_AUTO_DETECT=true

PERSONA_NAME=小丛雨
PERSONA_PROMPT_FILE=prompts/persona.txt
PERSONA_EXAMPLES_FILE=prompts/examples.jsonl
MAX_CONTEXT_MESSAGES=100
# 连续相同纯文本出现两次时自动复读一次；命令、链接和 @机器人 问句不会触发。
REPEAT_ECHO_ENABLED=true
# 最多从 NapCat 拉取 3000 条群历史并缓存在进程内；注入模型仍受字符预算保护。
GROUP_CONTEXT_HISTORY_COUNT=3000
GROUP_CONTEXT_MESSAGE_LIMIT=3000
GROUP_CONTEXT_CHAR_LIMIT=120000
QQ_SEND_CHUNK_CHARS=1800

# 猫 GIF 优先用 GIPHY，页面失效时用 CATAAS；不用 API Key。
CAT_GIPHY_ENABLED=true
CAT_GIPHY_PAGE_URL=https://giphy.com/gifs/art-cat-HMDsITZh2SBGM
CAT_API_URL=https://cataas.com/cat/gif
CAT_TIMEOUT_SECONDS=12
CAT_CACHE_SIZE=6
# 所有猫图来源共用的永久去重记录；重启后继续保留，不存图片文件。
CAT_HISTORY_PATH=./data/cat_image_history.sqlite3
# Wikimedia Commons：精选真实猪照片，无需 API Key。
PIG_API_URL=https://commons.wikimedia.org/w/api.php
MEDIA_MAX_BYTES=5242880
MEDIA_TIMEOUT_SECONDS=60
MEDIA_RETRY_ATTEMPTS=2

# Deezer 公共搜索：国际曲库较全，可试听 30 秒，无需 Key。
MUSIC_API_URL=https://api.deezer.com
MUSIC_TIMEOUT_SECONDS=10
MUSIC_SEARCH_LIMIT=8
SINGING_ENABLED=false
SINGING_HF_OFFLINE=false
SINGING_PYTHON=./data/singing/runtime/.venv/Scripts/python.exe
SINGING_SEED_ROOT=./data/singing/runtime/seed-vc
SINGING_FFMPEG_PATH=./data/singing/runtime/bin/ffmpeg.exe
SINGING_FFPROBE_PATH=./data/singing/runtime/bin/ffprobe.exe
SINGING_USE_TRAINED_TTS_REFERENCE=true
SINGING_REAL_REFERENCE_PROFILE_IDS=murasame
SINGING_REFERENCE_AUDIO_BY_PROFILE_JSON={}
# 用干净原录音；别把上次合成的歌声再当参考。
SINGING_REFERENCE_MAX_SECONDS=8
# 微调后咬字变差时，可填角色 ID（逗号分隔）回到基础模型，权重仍保留。
SINGING_BASE_MODEL_PROFILE_IDS=
# 各角色音高偏移：整数半音，范围 -12 到 +12。
# 偏移一个八度（+12/-12）时，伴奏保持原调。
SINGING_SEMITONE_SHIFT_BY_PROFILE_JSON={}
# 可选目标歌唱音域，单位 Hz；自动选择 -12、0 或 +12。
# 上方明确设置的半音值优先。示例：{"murasame":400}
SINGING_TARGET_MEDIAN_F0_BY_PROFILE_JSON={}
SINGING_VOCAL_TARGET_RMS=0.20
SINGING_MASTER_GAIN=0.93
SINGING_CHUNK_SECONDS=115
# 片段翻唱的目标时长，会尽量对齐歌词句子。
SINGING_CLIP_SECONDS=20
# 唱歌优先使用原始角色录音，避免聊天 TTS 的失真传入翻唱。
SINGING_PREFER_RECORDED_REFERENCE=true
# 保留正常伴奏，只给弱人声补音量。
SINGING_ACCOMPANIMENT_GAIN=0.85
SINGING_VOCAL_BACKGROUND_GAP_DB=3
SINGING_SEED=20261004
# 孤立音高尖跳修复先关闭，试听对比后再决定。
SINGING_REPAIR_F0_SPIKES=false
SINGING_MIN_VOICED_RECALL=0.88
SINGING_MIN_ENERGY_RECALL=0.90
SINGING_MAX_MISSING_VOCAL_SECONDS=1.2
HELP_MENU_BACKGROUND_PATH=./assets/help-menu-background.png
SINGING_MAX_SONG_SECONDS=600
SINGING_MODEL_TIMEOUT_SECONDS=900
SINGING_JOB_TIMEOUT_SECONDS=2400
SINGING_QUEUE_SIZE=3
SINGING_COOLDOWN_SECONDS=120
SINGING_SEGMENT_PAUSE_SECONDS=1.5
SINGING_DIFFUSION_STEPS=35
SINGING_INFERENCE_CFG_RATE=0.7
# 例如 {"aimisi":0.7}，只覆盖这个角色；其他角色沿用通用值。
SINGING_INFERENCE_CFG_RATE_BY_PROFILE_JSON={}
SINGING_SEPARATION_MODEL=htdemucs_ft
SINGING_MAX_PITCH_ERROR_CENTS=100
SINGING_MIN_VOICE_SIMILARITY=0.35
# 主要音乐曲库使用网易云音乐网页搜索接口，
# 这不是官方公开开发者 API，接口可能随时变化。
NETEASE_MUSIC_API_URL=https://music.163.com/api/search/get
# 可选：通过本地会员桥接登录自己的网易云账号。
# 运行 scripts/start_netease_member.ps1，再打开 http://127.0.0.1:3010/login。
NETEASE_MEMBER_ENABLED=false
NETEASE_MEMBER_BRIDGE_URL=http://127.0.0.1:3010
NETEASE_MEMBER_TOKEN_PATH=./data/netease/bridge-token.txt

# 哔哩哔哩公开网页搜索。机器人会自动获取匿名 Cookie。
BILIBILI_SEARCH_URL=https://api.bilibili.com/x/web-interface/search/type
BILIBILI_TIMEOUT_SECONDS=10
BILIBILI_SEARCH_RESULT_LIMIT=20

# 憑依风格学习：后台分析近期 OneBot 聊天记录。
# 不保存原始聊天内容，只保存简短的风格摘要。
POSSESSION_STYLE_HISTORY_COUNT=200
# 每名成员的进程内样本与风格匹配最多保留 200 条。
POSSESSION_STYLE_SAMPLE_LIMIT=200
POSSESSION_STYLE_REFRESH_HOURS=24
# 憑依主动回忆会检查成员最近 200 条消息，以准确匹配内容。
POSSESSION_RECALL_HISTORY_COUNT=200
POSSESSION_RECALL_RESULT_LIMIT=12

# 媒体和新闻快速响应
ULTRAMAN_IMAGE_RESOLVE_TIMEOUT_SECONDS=8
ULTRAMAN_IMAGE_CACHE_DIR=./data/ultraman_image_cache
ANIME_IMAGE_RESOLVE_TIMEOUT_SECONDS=24
ANIME_IMAGE_CACHE_DIR=./data/anime_image_cache
# 萌娘百科图片仅在已取得其用户协议要求的机器人抓取/站外使用许可后开启。
MOEGIRL_IMAGE_PROVIDER_ENABLED=false
# 获得授权并启用后，将动漫目录角色资料和图片限制为
# 已核实的萌娘百科页面。没有对应条目时会明确显示缺失。
ANIME_MOEGIRL_ONLY=false
# 当 ANIME_MOEGIRL_ONLY=true 时，设为 true 可优先使用已核实的萌娘百科
# 图片；没有可下载图片或 CDN 失败时，再依次回退到 Bangumi/VNDB/AniList
# 组合来源和现有的审核来源。
# 此模式下角色资料文字仍只使用萌娘百科。
ANIME_MOEGIRL_PREFERRED_WITH_FALLBACK=false
# 可选的 OpenAI 兼容图片生成服务。配置完成前保持关闭。
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_API_URL=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=
IMAGE_GENERATION_SIZE=1024x1024
IMAGE_GENERATION_TIMEOUT_SECONDS=90
IMAGE_GENERATION_MAX_PROMPT_CHARS=500
IMAGE_GENERATION_COOLDOWN_SECONDS=20
# 用户提供的丛雨素材（images/、emotes/、voices/）。
MURASAME_ASSET_DIR=./data/murasame_assets
MURASAME_IMAGE_SUBDIR=images
MURASAME_EMOJI_SUBDIR=emotes
# 可选的 OpenAI 兼容 TTS；个人音色模式默认关闭。
VOICE_ENABLED=false
VOICE_PROVIDER=openai_compatible
VOICE_API_URL=
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=alloy
VOICE_PROFILE_DEFAULT=murasame
VOICE_SUPPORTS_LANGUAGE_FIELDS=false
# 角色音色授权仅限此机器人 ONEBOT_SELF_ID。事件缺少
# self_id 时不能使用。完成本地验收后可填写示例：yoshino,mako
VOICE_PRIMARY_ACCOUNT_PROFILE_IDS=
# 示例：添加已授权角色，且服务端必须支持。每个 profile 可选配置
# ref_audio_path_by_language、prompt_text_by_language 和
# prompt_lang_by_language，均为以 zh/ja/en/yue 为键的 JSON 对象。未配置的项
# 使用对应的旧标量值；格式错误时回退为文字。
# supported_languages 是可选的语言允许列表，例如
# ["zh","en","yue"]。配置后只接受不重复的 zh/ja/en/yue
# 值；未列出的语言回退为文字。只有角色粤语合成和 ASR 验收通过后
# 才添加 yue。省略此项可保留旧行为。
# text_split_method 是 profile 的可选项：只接受 cut0 到 cut5。
# 省略时不在请求中发送，由 api_v2 使用当前 cut5 默认值。
# profile 可选配置 seed（-1..2^32-1）、top_k（1..100）、temperature
# （0.1..2.0）、parallel_infer 和 split_bucket，覆盖全局采样设置。
# 布尔值必须写 JSON true/false；省略字段则使用默认值。
VOICE_PROFILES_JSON={"murasame":{"label":"小丛雨","voice":"murasame","language":"zh","languages":"中 / 日 / 英","target_language":"zh","prompt_lang":"ja","prompt_text":"","ref_audio_path":"data/murasame_voice_dataset_ja/audio/murasame_0001.mp3"}}
VOICE_TIMEOUT_SECONDS=45
VOICE_MAX_CHARS=360
# 配置 VOICE_PROVIDER=gpt_sovits 且 VOICE_ENABLED=true 时，start_all.ps1 会自动
# 启动本地 api_v2.py sidecar。模型和音频不要放进 Git。
GPT_SOVITS_AUTO_START=auto
GPT_SOVITS_ROOT=../qq-chatrobot-voice/GPT-SoVITS
GPT_SOVITS_PYTHON=../qq-chatrobot-voice/GPT-SoVITS/.venv/Scripts/python.exe
GPT_SOVITS_HOST=127.0.0.1
GPT_SOVITS_PORT=9880
GPT_SOVITS_TTS_CONFIG=GPT_SoVITS/configs/tts_infer.yaml
# 可选的微调 SoVITS 权重；留空时使用预训练模型。
GPT_SOVITS_SOVITS_WEIGHTS=
# 可选的同一 sidecar 按语言路由。所有本地权重通过验收前保持留空；
# 此处尚未部署 e13。
VOICE_SOVITS_WEIGHTS_BY_LANGUAGE_JSON=
# 仅作示例（部署后取消注释并替换所有路径）：
# VOICE_SOVITS_WEIGHTS_BY_LANGUAGE_JSON={"zh":"C:/accepted/murasame_e13.pth","ja":"C:/accepted/murasame_e12.pth","en":"C:/accepted/murasame_e12.pth"}
# 可选的同一 sidecar 角色专属路由。每个非默认 profile 必须配置自己的
# 各语言权重，不会继承
# 默认 profile 的映射。对应 profile 和本地权重准备好前保持留空。
VOICE_SOVITS_WEIGHTS_BY_PROFILE_JSON=
VOICE_GPT_WEIGHTS_BY_PROFILE_JSON=
# 可选的 profile -> GPT 检查点映射；配置后须包含每个已启用角色。
# 示例：VOICE_GPT_WEIGHTS_BY_PROFILE_JSON={"murasame":"C:/accepted/murasame.ckpt"}
# 仅作示例：VOICE_SOVITS_WEIGHTS_BY_PROFILE_JSON={"profile_id":{"zh":"C:/accepted/profile_zh.pth"}}
VOICE_SEND_COOLDOWN_SECONDS=20
# GPT-SoVITS 采样参数保持稳定；只有测试其他模型时才调整。
VOICE_SEED=17
VOICE_TOP_K=15
VOICE_TEMPERATURE=0.8
VOICE_REPETITION_PENALTY=1.35
DAILY_NEWS_ENABLED=true
DAILY_NEWS_HOUR=12
DAILY_NEWS_MINUTE=0
DAILY_NEWS_TIMEZONE=Asia/Shanghai
DAILY_NEWS_GROUP_LOOKBACK_DAYS=30
