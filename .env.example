APP_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=./data/qqchat.db
REDIS_URL=redis://redis:6379/0
EVENT_DEDUPE_TTL_SECONDS=300
USER_RATE_LIMIT_PER_MINUTE=5
GROUP_RATE_LIMIT_PER_MINUTE=60
PLUGIN_MODULES=app.plugins.hello

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=qqchat-robot
JWT_AUDIENCE=qqchat-admin
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=14
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# 本机 NapCat 示例：http://127.0.0.1:3000；Docker 运行机器人时通常使用 http://host.docker.internal:3000
ONEBOT_API_BASE=
# 对应 OneBot HTTP Server 的 token
ONEBOT_ACCESS_TOKEN=
# 对应 OneBot HTTP Client（事件上报）的 token
ONEBOT_WEBHOOK_TOKEN=
ONEBOT_SELF_ID=

LLM_PROVIDER=zhipu
LLM_MODEL=glm-4.7-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=change-me
LLM_FALLBACK_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=500
LLM_TEMPERATURE=0.7
LLM_MAX_CONCURRENCY=10
LLM_QUEUE_SIZE=30
LLM_QUEUE_TIMEOUT_SECONDS=8

PERSONA_NAME=阿柚
PERSONA_PROMPT_FILE=prompts/persona.txt
PERSONA_EXAMPLES_FILE=prompts/examples.jsonl
MAX_CONTEXT_MESSAGES=10

# TheCatAPI: create a free key at https://thecatapi.com/signup
CAT_API_URL=https://api.thecatapi.com/v1/images/search
CAT_API_KEY=
# Wikimedia Commons: curated real pig photographs; no API key required
PIG_API_URL=https://commons.wikimedia.org/w/api.php
MEDIA_MAX_BYTES=5242880
MEDIA_TIMEOUT_SECONDS=60
MEDIA_RETRY_ATTEMPTS=2
