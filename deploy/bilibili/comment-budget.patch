+"""Deterministic controls for the configured owner's real Bilibili DM sender."""
+import re
+import unicodedata
+
+
+HELP = (
+    "主人控制菜单：\n运行状态\n暂停主动活动 / 恢复主动活动\n"
+    "关闭主动评论 / 开启主动评论\n关闭评论回复 / 开启评论回复\n"
+    "主动评论上限 5（每天1～10条）\n"
+    "也可以直接发视频让我总结，或说“找几个关于……的视频”。\n"
+    "这些开关会保存；暂停主动活动后，私信控制仍可使用。"
+)
+
+
+def parse_owner_control(content):
+    text = re.sub(r"\s+", "", unicodedata.normalize("NFKC", str(content or "")))
+    text = text.strip("/。.!！")
+    text = re.sub(r"^(?:请|帮我)", "", text)
+    if text in {"控制菜单", "主人菜单", "主人帮助", "bili控制", "bili帮助"}:
+        return "help", {}, ""
+    if text in {"运行状态", "bili状态", "查看运行状态"}:
+        return "status", {}, ""
+    switches = {
+        "暂停主动活动": ("ENABLE_PROACTIVE", False, "主动活动已暂停，私信仍可正常聊天和控制。"),
+        "关闭主动活动": ("ENABLE_PROACTIVE", False, "主动活动已暂停，私信仍可正常聊天和控制。"),
+        "停止主动活动": ("ENABLE_PROACTIVE", False, "主动活动已暂停，私信仍可正常聊天和控制。"),
+        "恢复主动活动": ("ENABLE_PROACTIVE", True, "主动活动已恢复，会遵守原有时段和次数上限。"),
+        "开启主动活动": ("ENABLE_PROACTIVE", True, "主动活动已恢复，会遵守原有时段和次数上限。"),
+        "关闭主动评论": ("PROACTIVE_COMMENT", False, "主动评论已关闭。"),
+        "暂停主动评论": ("PROACTIVE_COMMENT", False, "主动评论已关闭。"),
+        "开启主动评论": ("PROACTIVE_COMMENT", True, "主动评论已开启，仍遵守每日上限。"),
+        "恢复主动评论": ("PROACTIVE_COMMENT", True, "主动评论已开启，仍遵守每日上限。"),
+        "关闭评论回复": ("ENABLE_REPLY", False, "评论自动回复已关闭，私信控制保留。"),
+        "暂停评论回复": ("ENABLE_REPLY", False, "评论自动回复已关闭，私信控制保留。"),
+        "开启评论回复": ("ENABLE_REPLY", True, "评论自动回复已开启。"),
+        "恢复评论回复": ("ENABLE_REPLY", True, "评论自动回复已开启。"),
+    }
+    if text in switches:
+        key, value, reply = switches[text]
+        return "set", {key: value}, reply
+    limit = re.fullmatch(r"(?:每天)?主动评论(?:上限|最多)(\d{1,4})(?:条)?", text)
+    if limit:
+        count = int(limit[1])
+        if not 1 <= count <= 10:
+            return "error", {}, "主动评论每天可设1～10条；要停止评论，请发“关闭主动评论”。"
+        return "set", {"PROACTIVE_COMMENT_DAILY_LIMIT": count}, f"主动评论已设为每天最多{count}条，不会为了凑数发送。"
+    return None
+
+
+def owner_status(config, running):
+    on = lambda key: "开" if config.get(key, False) else "关"
+    return (
+        f"运行：{'正常' if running else '未运行'}\n"
+        f"主动活动：{on('ENABLE_PROACTIVE')}；主动评论：{on('PROACTIVE_COMMENT')}\n"
+        f"评论回复：{on('ENABLE_REPLY')}；私信回复：{on('PRIVATE_MESSAGE_AUTO_REPLY')}\n"
+        f"主动评论每日上限：{config.get('PROACTIVE_COMMENT_DAILY_LIMIT', 10)}条\n"
+        f"主动休息时段：{config.get('SLEEP_START', 23)}点～{config.get('SLEEP_END', 8)}点（北京时间）"
+    )
