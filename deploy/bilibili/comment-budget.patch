+import types
+from unittest.mock import AsyncMock
+
+import pytest
+import test_reliability as harness
+
+
+class Config(dict):
+    def save_config(self):
+        if getattr(self, "fail", False):
+            raise OSError("disk unavailable")
+        self.saved = dict(self)
+
+
+@pytest.fixture
+def bot():
+    case = harness.PrivateMessageReliabilityTests()
+    case.setUp()
+    instance = case.Bot()
+    instance.config = Config(OWNER_MID="123", ENABLE_PROACTIVE=True,
+                             ENABLE_REPLY=True, PRIVATE_MESSAGE_AUTO_REPLY=False)
+    instance._running = True
+    instance._send_bili_private_message = AsyncMock(return_value=True)
+    instance._private_runtime_event = lambda _message: object()
+
+    async def execute(_request, action):
+        return types.SimpleNamespace(success=await action(), state="succeeded")
+
+    instance.event_runtime = types.SimpleNamespace(
+        execute=AsyncMock(side_effect=execute),
+        claim=AsyncMock(return_value=types.SimpleNamespace(accepted=True, event_key="event-1")),
