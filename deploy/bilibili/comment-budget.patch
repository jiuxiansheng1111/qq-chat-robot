+"""Quiet hours pause proactive activity while keeping inbound replies alive."""
+import ast
+import asyncio
+import time
+import traceback
+import types
+import unittest
+from datetime import datetime
+from pathlib import Path
+from unittest.mock import AsyncMock, MagicMock
+
+
+class QuietInboundTests(unittest.IsolatedAsyncioTestCase):
+    async def run_one_loop(self, hour, *, enabled=True):
+        source = Path(__file__).resolve().parents[1] / "main.py"
+        tree = ast.parse(source.read_text(encoding="utf-8-sig"))
+        cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == "BiliBiliBot")
+        method = next(n for n in cls.body if isinstance(n, ast.AsyncFunctionDef) and n.name == "_main_loop")
+
+        class Clock:
+            @staticmethod
+            def now():
+                return datetime(2026, 10, 27, hour, 0)
+
+        bot = types.SimpleNamespace(
+            _running=True,
+            config={"SLEEP_START": 23, "SLEEP_END": 8,
+                    "ENABLE_PRIVATE_MESSAGES": enabled, "ENABLE_REPLY": enabled,
+                    "ENABLE_PROACTIVE": hour < 8, "POLL_INTERVAL": 60},
+            _maybe_evolve_personality=AsyncMock(),
+            _ensure_autonomous_daily_plan=AsyncMock(),
+            _poll_private_messages=AsyncMock(),
+            _poll_unified=AsyncMock(),
+            _consolidation=types.SimpleNamespace(should_run_today=lambda: False),
+            _consolidation_task=None,
+            _maybe_daily_summary=AsyncMock(),
+            _maybe_weekly_summary=AsyncMock(),
+            _last_cookie_check=time.time(),
+            _check_and_refresh_cookie=AsyncMock(),
+            _run_proactive=AsyncMock(),
+        )
+
+        async def sleep(_seconds):
+            bot._running = False
+
+        log = MagicMock()
+        namespace = {
+            "datetime": Clock, "time": time, "traceback": traceback,
+            "logger": log,
+            "asyncio": types.SimpleNamespace(sleep=sleep, CancelledError=asyncio.CancelledError),
+        }
+        exec(compile(ast.Module(body=[method], type_ignores=[]), str(source), "exec"), namespace)
+        await namespace["_main_loop"](bot)
+        log.error.assert_not_called()
+        bot._run_proactive.assert_not_awaited()
+        self.assertFalse(bot._running)
+        return bot
+
+    async def test_sleep_hours_still_poll_comments_and_private_messages(self):
+        bot = await self.run_one_loop(2)
+        bot._poll_private_messages.assert_awaited_once()
+        bot._poll_unified.assert_awaited_once()
+
+    async def test_sleep_hours_honor_disabled_reply_channels(self):
+        bot = await self.run_one_loop(2, enabled=False)
+        bot._poll_private_messages.assert_not_awaited()
+        bot._poll_unified.assert_not_awaited()
+
+    async def test_daytime_does_not_double_poll(self):
+        bot = await self.run_one_loop(12)
+        bot._poll_private_messages.assert_awaited_once()
+        bot._poll_unified.assert_awaited_once()
+
+
+if __name__ == "__main__":
+    unittest.main()
