+"""Shared daily comment ceiling regression tests."""
+
+import asyncio
+import json
+import tempfile
+import unittest
+from datetime import datetime, timezone
+from pathlib import Path
+
+from core.behavior_budget import BehaviorBudget
+from core.layered_runtime import LayeredRuntime
+from core.runtime import ActionRequest, EventRuntime, WriteResultUnknownError
+
+
+class SharedCommentBudgetTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.temp_dir = tempfile.TemporaryDirectory()
+        self.database_path = Path(self.temp_dir.name) / "bilibot.sqlite3"
+        self.config = {
+            "COMMENT_SHARED_DAILY_LIMIT": 1,
+            "BEHAVIOR_GLOBAL_MAX_PER_MINUTE": 0,
+            "BEHAVIOR_GLOBAL_DAILY_LIMIT": 0,
+            "AUTONOMOUS_REPLY_DAILY_LIMIT": 0,
+            "PROACTIVE_COMMENT_DAILY_LIMIT": 0,
+        }
+        self.layers = LayeredRuntime(self.config, self.database_path)
+        await self.layers.open()
+        self.runtime = EventRuntime(observer=self.layers)
+
+    async def asyncTearDown(self):
+        await self.layers.close()
+        self.temp_dir.cleanup()
+
+    async def test_concurrent_mixed_comments_share_the_last_slot(self):
+        calls = 0
+
+        async def send():
+            nonlocal calls
+            calls += 1
+            await asyncio.sleep(0)
+            return True
+
+        outcomes = await asyncio.gather(
+            self.runtime.execute(
+                ActionRequest(key="reply:1", kind="comment_reply"), send
+            ),
+            self.runtime.execute(
+                ActionRequest(key="proactive:1", kind="proactive_comment"), send
+            ),
+        )
+
+        self.assertEqual(sum(outcome.success for outcome in outcomes), 1)
+        denied = next(outcome for outcome in outcomes if not outcome.success)
+        self.assertIn("behavior:comment_shared:day", denied.reason)
+        self.assertEqual(calls, 1)
+        row = await self.layers.db.fetch_one(
+            "SELECT count FROM counters WHERE bucket=?",
+            ("behavior:comment_shared:day",),
+        )
+        self.assertEqual(row["count"], 1)
+
+    async def test_shared_count_survives_layered_runtime_restart(self):
+        first = await self.runtime.execute(
+            ActionRequest(key="reply:before-restart", kind="comment_reply"),
+            lambda: True,
+        )
+        self.assertTrue(first.success)
+
+        await self.layers.close()
+        self.layers = LayeredRuntime(self.config, self.database_path)
+        await self.layers.open()
+        self.runtime = EventRuntime(observer=self.layers)
+
+        second = await self.runtime.execute(
+            ActionRequest(key="proactive:after-restart", kind="proactive_comment"),
+            lambda: True,
+        )
+
+        self.assertFalse(second.success)
+        self.assertIn("behavior:comment_shared:day", second.reason)
+
+    async def test_shared_day_changes_at_utc_1600(self):
+        before_midnight_beijing = datetime(
+            2026, 10, 26, 15, 59, tzinfo=timezone.utc
+        ).timestamp()
+        midnight_beijing = datetime(
+            2026, 10, 26, 16, 0, tzinfo=timezone.utc
+        ).timestamp()
+        request = ActionRequest(key="day-key", kind="comment_reply")
+
+        first_rules = self.layers.behavior_budget.rules_for(
+            request, before_midnight_beijing
+        )
+        next_rules = self.layers.behavior_budget.rules_for(request, midnight_beijing)
+        shared_bucket = "behavior:comment_shared:day"
+
+        self.assertIn(
+            (shared_bucket, "2026-10-26", 1), first_rules
+        )
+        self.assertIn(
+            (shared_bucket, "2026-10-27", 1), next_rules
+        )
+        # Existing local-time windows remain unchanged for unrelated buckets.
+        self.assertEqual(
+            BehaviorBudget.window_keys(midnight_beijing)[0],
+            datetime.fromtimestamp(midnight_beijing).strftime("%Y-%m-%d"),
+        )
+
+    async def test_unknown_send_keeps_shared_reservation(self):
+        async def unknown_send():
+            raise WriteResultUnknownError("platform response lost")
+
+        unknown = await self.runtime.execute(
+            ActionRequest(key="reply:unknown", kind="comment_reply"), unknown_send
+        )
+        denied = await self.runtime.execute(
+            ActionRequest(key="proactive:after-unknown", kind="proactive_comment"),
+            lambda: True,
+        )
+
+        self.assertEqual(unknown.state, "unknown")
+        self.assertFalse(denied.success)
+        row = await self.layers.db.fetch_one(
+            "SELECT count FROM counters WHERE bucket=?",
+            ("behavior:comment_shared:day",),
+        )
+        self.assertEqual(row["count"], 1)
+
+    async def test_budget_exempt_comment_still_counts_even_when_general_budget_off(self):
+        await self.layers.close()
+        self.config["BEHAVIOR_BUDGET_ENABLED"] = False
+        self.layers = LayeredRuntime(self.config, self.database_path)
+        await self.layers.open()
+        self.runtime = EventRuntime(observer=self.layers)
+
+        first = await self.runtime.execute(
+            ActionRequest(
+                key="reply:exempt",
+                kind="comment_reply",
+                metadata={"budget_exempt": True},
+            ),
+            lambda: True,
+        )
+        second = await self.runtime.execute(
+            ActionRequest(key="proactive:normal", kind="proactive_comment"),
+            lambda: True,
+        )
+
+        self.assertTrue(first.success)
+        self.assertFalse(second.success)
+        self.assertIn("behavior:comment_shared:day", second.reason)
+
+    async def test_all_comment_write_kinds_use_the_shared_bucket(self):
+        cases = (
+            ActionRequest(key="reply", kind="comment_reply"),
+            ActionRequest(key="proactive", kind="proactive_comment"),
+            ActionRequest(key="tool", kind="tool_comment"),
+            ActionRequest(
+                key="owner-comment",
+                kind="proactive_owner_recommend",
+                metadata={"comment_write": True},
+            ),
+        )
+        shared_bucket = "behavior:comment_shared:day"
+
+        for request in cases:
+            with self.subTest(kind=request.kind, key=request.key):
+                self.assertIn(
+                    shared_bucket,
+                    {bucket for bucket, _, _ in self.layers.behavior_budget.rules_for(request, 0)},
+                )
+
+        # The same action kind is also used for private/QQ delivery. Those paths
+        # must not consume a Bilibili comment slot.
+        owner_message = ActionRequest(
+            key="owner-private", kind="proactive_owner_recommend"
+        )
+        self.assertNotIn(
+            shared_bucket,
+            {
+                bucket
+                for bucket, _, _ in self.layers.behavior_budget.rules_for(
+                    owner_message, 0
+                )
+            },
+        )
+
+    async def test_comment_write_fails_closed_when_database_is_closed(self):
+        await self.layers.close()
+        calls = 0
+
+        async def send():
+            nonlocal calls
+            calls += 1
+            return True
+
+        result = await self.runtime.execute(
+            ActionRequest(key="comment:db-closed", kind="tool_comment"), send
+        )
+
+        self.assertFalse(result.success)
+        self.assertIn("comment_budget_unavailable", result.reason)
+        self.assertEqual(calls, 0)
+
+    async def test_comment_write_fails_closed_when_before_action_raises(self):
+        class BrokenObserver:
+            async def before_action(self, _request):
+                raise OSError("sqlite unavailable")
+
+        calls = 0
+
+        async def send():
+            nonlocal calls
+            calls += 1
+            return True
+
+        result = await EventRuntime(observer=BrokenObserver()).execute(
+            ActionRequest(key="comment:observer-error", kind="proactive_comment"),
+            send,
+        )
+
+        self.assertFalse(result.success)
+        self.assertIn("comment_budget_unavailable", result.reason)
+        self.assertEqual(calls, 0)
+
+    async def test_comment_write_fails_closed_for_missing_or_unknown_reservation(self):
+        class NoReservationObserver:
+            async def before_action(self, _request):
+                return None
+
+        class UnknownReservationObserver:
+            async def before_action(self, _request):
+                return False, "send_state_unknown", False, "unknown"
+
+        class MalformedReservationObserver:
+            async def before_action(self, _request):
+                return True
+
+        observers = (
+            NoReservationObserver(),
+            UnknownReservationObserver(),
+            MalformedReservationObserver(),
+            None,
+        )
+        for index, observer in enumerate(observers):
+            with self.subTest(observer=type(observer).__name__ if observer else "none"):
+                calls = 0
+
+                async def send():
+                    nonlocal calls
+                    calls += 1
+                    return True
+
+                result = await EventRuntime(observer=observer).execute(
+                    ActionRequest(
+                        key=f"comment:no-reservation:{index}",
+                        kind="proactive_owner_recommend",
+                        metadata={"comment_write": True},
+                    ),
+                    send,
+                )
+
+                self.assertFalse(result.success)
+                self.assertEqual(calls, 0)
+
+    async def test_comment_write_fails_closed_when_start_observer_raises(self):
+        layers = self.layers
+
+        class StartFailureObserver:
+            async def before_action(self, request):
+                return await layers.before_action(request)
+
+            async def on_action_started(self, _request):
+                raise OSError("sqlite update failed")
+
+            async def on_action_finished(self, request, state, reason=""):
+                await layers.on_action_finished(request, state, reason)
+
+        calls = 0
+
+        async def send():
+            nonlocal calls
+            calls += 1
+            return True
+
+        result = await EventRuntime(observer=StartFailureObserver()).execute(
+            ActionRequest(key="comment:start-error", kind="tool_comment"), send
+        )
+
+        self.assertFalse(result.success)
+        self.assertIn("comment_budget_start_unavailable", result.reason)
+        self.assertEqual(calls, 0)
+        count = await self.layers.db.fetch_value(
+            "SELECT count FROM counters WHERE bucket=?",
+            ("behavior:comment_shared:day",),
+            default=0,
+        )
+        self.assertEqual(count, 0)
+
+    async def test_comment_write_fails_closed_when_start_is_not_confirmed(self):
+        layers = self.layers
+
+        class StartNotConfirmedObserver:
+            async def before_action(self, request):
+                return await layers.before_action(request)
+
+            async def on_action_started(self, _request):
+                return None
+
+            async def on_action_finished(self, request, state, reason=""):
+                await layers.on_action_finished(request, state, reason)
+
+        calls = 0
+
+        async def send():
+            nonlocal calls
+            calls += 1
+            return True
+
+        result = await EventRuntime(observer=StartNotConfirmedObserver()).execute(
+            ActionRequest(key="comment:start-missing", kind="comment_reply"), send
+        )
+
+        self.assertFalse(result.success)
+        self.assertEqual(result.reason, "comment_budget_start_not_confirmed")
+        self.assertEqual(calls, 0)
+        count = await self.layers.db.fetch_value(
+            "SELECT count FROM counters WHERE bucket=?",
+            ("behavior:comment_shared:day",),
+            default=0,
+        )
+        self.assertEqual(count, 0)
+
+    async def test_successful_start_marks_action_running_before_comment_send(self):
+        observed = []
+
+        async def send():
+            row = await self.layers.db.fetch_one(
+                "SELECT state,attempts FROM actions WHERE key=?",
+                ("comment:start-confirmed",),
+            )
+            observed.append((row["state"], row["attempts"]))
